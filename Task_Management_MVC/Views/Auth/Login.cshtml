@using Microsoft.Extensions.Localization
@using Task_Management_MVC.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["Login"];
}

<div class="login-page">
    <!-- Language and theme buttons -->
    <div class="top-controls">

        <button type="button"
                id="languageButton"
                class="control-button">

            @(System.Globalization.CultureInfo.CurrentUICulture
                .TwoLetterISOLanguageName == "ar" ? "EN" : "AR")

        </button>

        <button type="button"
                id="themeButton"
                class="control-button">

            Dark Mode

        </button>

    </div>


    <!-- Login card -->
    <div class="login-card">

        <div class="login-heading">

            <h1>
                @Localizer["WelcomeBack"]
            </h1>

            <p>
                @Localizer["SignInToAccount"]
            </p>

        </div>


        <form id="loginForm">

            <!-- Email -->
            <div class="form-group">

                <label for="email">
                    @Localizer["Email"]
                </label>

                <input type="email"
                       id="email"
                       name="email"
                       placeholder="@Localizer["EnterYourEmail"]"
                       autocomplete="email"
                       required />

            </div>


            <!-- Password -->
            <div class="form-group">

                <label for="password">
                    @Localizer["Password"]
                </label>

                <div class="password-wrapper">

                    <input type="password"
                           id="password"
                           name="password"
                           placeholder="@Localizer["EnterYourPassword"]"
                           autocomplete="current-password"
                           required />

                    <button type="button"
                            id="passwordToggle"
                            class="password-toggle">

                        Show

                    </button>

                </div>

            </div>


            <!-- Login button -->
            <button type="submit"
                    id="loginButton"
                    class="login-button">

                @Localizer["SignIn"]

            </button>


            <!-- Forgot password -->
            <div class="forgot-password">

                <a href="#"
                   id="forgotPasswordLink">

                    @Localizer["ForgotPassword"]

                </a>

            </div>


            <!-- Divider -->
            <div class="divider">

                <span></span>

                <p>or</p>

                <span></span>

            </div>


            <!-- Register -->
            <div class="register">

                <span>
                    @Localizer["NoAccount"]
                </span>

                <a href="#"
                   id="registerLink">

                    @Localizer["Register"]

                </a>

            </div>


            <!-- Login result -->
            <div id="loginMessage"></div>

        </form>

    </div>


    <!-- Small quote -->
    <div class="login-quote">

         @Localizer["Small steps lead to big progress."]

    </div>

</div>


@section Scripts {

    <script src="~/js/Login.js"></script>

}